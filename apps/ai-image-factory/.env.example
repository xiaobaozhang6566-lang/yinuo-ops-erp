# Required for server-side image generation. Never expose as NEXT_PUBLIC_*.
OPENAI_API_KEY=

# Optional model overrides. Models remain disabled until validated.
IMAGE_MODEL_SUNBURST=gpt-image-2.5-sunburst
IMAGE_MODEL_FLARE=gpt-image-2.5-flare

# Safety controls (USD). Generation must fail closed if limits are unavailable.
IMAGE_FACTORY_DAILY_BUDGET_USD=5
IMAGE_FACTORY_MAX_IMAGES_PER_REQUEST=1
IMAGE_FACTORY_ENABLE_PAID_GENERATION=false

# Isolated Supabase project/storage will be configured after the target is approved.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=yinuo-image-factory
